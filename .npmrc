# onnxruntime-node (a transitive dependency of the optional @huggingface/transformers,
# see lib/chatbot/embed.mjs) runs a postinstall script that, on linux/x64 — this repo's
# CI and Vercel build platform — unconditionally tries to fetch CUDA execution-provider
# binaries from a CDN with zero retry (a raw https.get, reject on any non-200 or network
# error; see node_modules/onnxruntime-node/script/install-utils.js's downloadFile). This
# app never requests the CUDA execution provider — transformers.js defaults every
# pipeline to the "cpu" device (node_modules/@huggingface/transformers/src/backends/onnx.js:
# defaultDevices = ['cpu']), and embed.mjs never overrides it. The CPU binaries onnxruntime-node
# actually needs are already bundled in its own npm package; only the unused CUDA extra
# requires a separate network round-trip. Skipping it removes a real, external, single-shot,
# zero-retry network dependency from every `npm ci`/`npm install` — CI, Vercel, and local
# setup alike — with no change to what the app can do, since it never used the GPU path.
#
# Caused two separate CI failures in one round (a chatbot-eval job and an /ask e2e test,
# both re-run to green) before being traced to this exact mechanism — see CHECKS.md's own
# "the same asymmetry in the dependency tree" section, which named the risk but not, until
# now, a fix that removes the fetch rather than retrying around it.
onnxruntime-node-install=skip
